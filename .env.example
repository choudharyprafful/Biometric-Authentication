# Copy to .env and fill in real values. Never commit .env itself — see .gitignore.

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/secureai
SESSION_SECRET=replace-with-a-long-random-string

# Local development. `pnpm --filter @workspace/api-server run dev` reads this file; a real
# deployment sets its own environment instead (NODE_ENV=production there).
NODE_ENV=development
PORT=8080

# Optional — see README.md "Quick start" for what each one does and its fallback behavior
# Encryption at rest. Set in production: 64 hex characters, e.g. `openssl rand -hex 32`.
FILE_ENCRYPTION_KEY=
FILE_ENCRYPTION_KEY_ID=k1
# Older keys still needed for reading during a rotation: k1:<hex>,k0:<hex>
FILE_ENCRYPTION_PREVIOUS_KEYS=
# Production only: comma-separated origins allowed by CORS (localhost is allowed in development).
FRONTEND_ORIGINS=
WEBHOOK_SECRET=

# Optional — real email delivery for password-reset and parent-consent links.
# Leave unset to keep using the dev-only link returned in the API response instead.
APP_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional — upload scanning, alerts, behaviour-model privacy. (Retention periods are fixed in code: docs/05 §3.)
CLAMD_HOST=
CLAMD_PORT=3310
SECURITY_ALERT_WEBHOOK_URL=
BEHAVIOR_MODEL_DP_EPSILON=
