# Copy to .env and fill in real values. Never commit .env itself — see .gitignore.

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/secureai
SESSION_SECRET=replace-with-a-long-random-string

# Optional — see replit.md "Run & Operate" for what each one does and its fallback behavior
FILE_ENCRYPTION_KEY=
WEBHOOK_SECRET=
