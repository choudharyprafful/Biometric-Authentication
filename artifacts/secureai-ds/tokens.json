{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "SecureAI Design System — extracted from the live SecureAI Biometric Security Demo. Dark cyberpunk cockpit aesthetic: electric-cyan primary on deep navy, zero-radius sharp corners, JetBrains Mono for all technical labels, Inter for UI copy. This file is the single source of truth. Edit values here only — never hand-edit src/index.css or src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "$description": "Derived light mode — SecureAI is dark-first. Light adapts the navy/cyan palette to a blue-tinted white surface for accessibility in bright environments.",
      "background":             { "$value": "#f0f5ff" },
      "foreground":             { "$value": "#0a1426" },
      "border":                 { "$value": "#c5d4e8" },
      "card":                   { "$value": "#ffffff" },
      "cardForeground":         { "$value": "#0a1426" },
      "popover":                { "$value": "#ffffff" },
      "popoverForeground":      { "$value": "#0a1426" },
      "primary": {
        "$value": "#007a8c",
        "$description": "Electric Cyan darkened for legibility on light surfaces. Drives buttons, links, focus rings."
      },
      "primaryForeground":      { "$value": "#ffffff" },
      "secondary":              { "$value": "#e2edf8" },
      "secondaryForeground":    { "$value": "#0a1426" },
      "muted":                  { "$value": "#e2edf8" },
      "mutedForeground":        { "$value": "#4a6280" },
      "accent":                 { "$value": "#007a8c" },
      "accentForeground":       { "$value": "#ffffff" },
      "destructive":            { "$value": "#dc2626" },
      "destructiveForeground":  { "$value": "#ffffff" },
      "input":                  { "$value": "#c5d4e8" },
      "ring":                   { "$value": "#007a8c" },
      "chart1":                 { "$value": "#007a8c" },
      "chart2":                 { "$value": "#4f46e5" },
      "chart3":                 { "$value": "#d97706" },
      "chart4":                 { "$value": "#9333ea" },
      "chart5":                 { "$value": "#dc2626" },
      "sidebar":                { "$value": "#e2edf8" },
      "sidebarForeground":      { "$value": "#0a1426" },
      "sidebarBorder":          { "$value": "#c5d4e8" },
      "sidebarPrimary":         { "$value": "#007a8c" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent":          { "$value": "#cfdff2" },
      "sidebarAccentForeground": { "$value": "#0a1426" },
      "sidebarRing":            { "$value": "#007a8c" }
    },
    "dark": {
      "$description": "Primary mode — the cockpit. Deep navy canvas, electric-cyan emphasis, sharp zero-radius corners.",
      "background": {
        "$value": "#070c18",
        "$description": "hsl(222, 47%, 4%) — near-black deep navy."
      },
      "foreground": {
        "$value": "#dce6f5",
        "$description": "hsl(214, 32%, 91%) — cool light slate."
      },
      "border": {
        "$value": "#111d2e",
        "$description": "hsl(222, 47%, 12%) — dark navy border."
      },
      "card": {
        "$value": "#09101e",
        "$description": "hsl(222, 47%, 6%) — slightly elevated surface."
      },
      "cardForeground":         { "$value": "#dce6f5" },
      "popover":                { "$value": "#09101e" },
      "popoverForeground":      { "$value": "#dce6f5" },
      "primary": {
        "$value": "#04d9ee",
        "$description": "hsl(185, 96%, 48%) — Electric Cyan. The signature accent of SecureAI."
      },
      "primaryForeground": {
        "$value": "#070c18",
        "$description": "Dark navy — legible on Electric Cyan."
      },
      "secondary":              { "$value": "#0e1929" },
      "secondaryForeground":    { "$value": "#dce6f5" },
      "muted":                  { "$value": "#0e1929" },
      "mutedForeground":        { "$value": "#94aab8" },
      "accent": {
        "$value": "#04d9ee",
        "$description": "Electric Cyan — same as primary; used for hover/interactive surfaces."
      },
      "accentForeground":       { "$value": "#070c18" },
      "destructive": {
        "$value": "#f0294a",
        "$description": "hsl(350, 89%, 60%) — alert red for errors and dangerous actions."
      },
      "destructiveForeground":  { "$value": "#f5f9ff" },
      "input":                  { "$value": "#111d2e" },
      "ring":                   { "$value": "#04d9ee" },
      "chart1":                 { "$value": "#04d9ee" },
      "chart2":                 { "$value": "#667eea" },
      "chart3":                 { "$value": "#f6a623" },
      "chart4":                 { "$value": "#b44dff" },
      "chart5":                 { "$value": "#f0294a" },
      "sidebar":                { "$value": "#070c18" },
      "sidebarForeground":      { "$value": "#dce6f5" },
      "sidebarBorder":          { "$value": "#111d2e" },
      "sidebarPrimary":         { "$value": "#04d9ee" },
      "sidebarPrimaryForeground": { "$value": "#070c18" },
      "sidebarAccent":          { "$value": "#0e1929" },
      "sidebarAccentForeground": { "$value": "#dce6f5" },
      "sidebarRing":            { "$value": "#04d9ee" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Inter — UI copy, body text, descriptions, and all prose."
      },
      "serif": {
        "$value": ["Georgia", "serif"],
        "$description": "Fallback serif — not used in SecureAI UI."
      },
      "mono": {
        "$value": ["JetBrains Mono", "monospace"],
        "$description": "JetBrains Mono — ALL technical labels, headings, category tags, log entries, badge text, and numeric readouts. The signature typographic voice of SecureAI."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0rem",
      "$description": "Zero radius — sharp edges everywhere. The 'technical cockpit' aesthetic demands hard corners. No rounding at any scale."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step (4px). All layout spacing multiples derive from this."
    }
  }
}
