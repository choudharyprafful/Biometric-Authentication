# Copy to .env (git-ignored). Expo inlines EXPO_PUBLIC_* values into the app bundle at build time, so
# never put a secret here. Leave both unset to use the local API through `adb reverse tcp:8080 tcp:8080`.
EXPO_PUBLIC_API_BASE_URL=https://d2zb1uxt99m5ks.cloudfront.net/api
# Sent as the Origin header; must be on the API's FRONTEND_ORIGINS list.
EXPO_PUBLIC_APP_ORIGIN=https://secureai-mobile.app
