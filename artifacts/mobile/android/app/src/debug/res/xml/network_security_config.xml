<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: replaces src/main/res/xml/network_security_config.xml for the debug variant.

  Once an app has a network security config, Android 7 and later ignore the manifest's
  usesCleartextTraffic, so src/debug/AndroidManifest.xml's override alone did not let a debug build
  reach Metro or a local API over plain HTTP: on a real phone it showed "Could not connect to
  development server" (found 2026-10-16). This file allows plain HTTP to the addresses local
  development uses (adb reverse makes the computer's ports appear on the phone's localhost, and
  10.0.2.2 is the computer as seen from the emulator) and nowhere else.

  The production pins are the same as in the main file, so a debug build pointed at the live API
  is pinned too. When the pins change there, change them here as well.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <domain-config>
        <domain includeSubdomains="true">d2zb1uxt99m5ks.cloudfront.net</domain>
        <pin-set expiration="2027-03-01">
            <pin digest="SHA-256">dExBlAvT1n9yGuq8/3TYV0mGSoCBmqDo+95Hxr2avEE=</pin>
            <pin digest="SHA-256">G9LNNAql897egYsabashkzUCTEJkWBzgoEtk8X/678c=</pin>
            <pin digest="SHA-256">++MBgDH5WGvL9Bcn5Be30cRcL0f5O+NyoXuWtQdX1aI=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
